---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Personal Homepage Demo',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '/' },
        { text: 'About', href: getPermalink('/about') },
        { text: 'Resume', href: getPermalink('/resume') },
        { text: 'Portfolio', href: '/category/portfolio' },
        { text: 'Blog', href: '/blog' },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[]}
    image={{
      src: 'src/assets/images/muhammad-ilham-hidayat.jpg',
      alt: 'Profile Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p class="text-justify">
        👋 Hello, my name is Ilham. Currently I'm working at Hijra to bring sharia-compliant financial technology
        solutions as a Back End software engineer
      </p>
      <br />
      <p class="text-justify">
        🛠️ Experienced in developing and maintaining backend application API and API integrations using Golang, Java,
        Modular Monolith, Microservices, and Event Driven.
      </p>
      <br />
      <p class="text-justify">👐 But I don't limit myself working on Front End and Data Engineering as well.</p>
      <br />
      <p class="text-justify">🎮 My hobbies are collecting Mini 4WD, building GunPla, and reading books.</p>
      <br />
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features3 Widget ************** -->

  <Hero
    tagline="Mini 4WD Collection"
    title=""
    subtitle=""
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'AstroWind Hero Image',
    }}
  />

  <Hero
    tagline="Gunpla Collection"
    title=""
    subtitle=""
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'AstroWind Hero Image',
    }}
  />
</Layout>
