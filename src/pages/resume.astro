        { text: 'Home', href: '/' },
        { text: 'About', href: getPermalink('/about2') },
        { text: 'Resume', href: getPermalink('/resume') },
        { text: 'Portfolio', href: getPermalink('/portfolio') },
        { text: 'Blog', href: '/blog' },
