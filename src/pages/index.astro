---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Personal Homepage Demo',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About', href: getPermalink('/about2') },
        { text: 'Resume', href: getPermalink('/resume') },
        { text: 'Portfolio', href: '/category/portfolio' },
        { text: 'Blog', href: '/blog' },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero id="hero" title="Hi there 👋, I'm ilham.">
    <Fragment slot="subtitle"> Welcome to my blog. </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    image={{
      src: 'src/assets/images/muhammad-ilham-hidayat.jpg',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>I'm a software engineer from Indonesia 🇮🇩.</p>
      <br />
      <p>
        While my primary focus is on back end development, I'm open to exploring and working on other areas such as
        front end 😁.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts id="blog" title="Explore my insightful articles on my blog">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
